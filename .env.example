# ============================================================
# CONTOH KONFIGURASI LINGKUNGAN - SIDU Desa Hulu Pancur Batu
# Salin file ini menjadi .env lalu isi nilainya:
#   copy .env.example .env        (Windows CMD)
#   Copy-Item .env.example .env   (PowerShell)
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE (PostgreSQL 16)
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres:GANTI_PASSWORD_DB@localhost:5432/hulu_pancur_batu?schema=public"

# ------------------------------------------------------------
# 2. AUTENTIKASI (NextAuth / Auth.js v5)
# ------------------------------------------------------------
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="GANTI_DENGAN_STRING_ACAK_MINIMAL_32_BYTE"
# AUTH_SECRET="GANTI_DENGAN_STRING_ACAK_MINIMAL_32_BYTE"

# URL aplikasi untuk tautan reset password di email.
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# 3. EMAIL OTP (Nodemailer - src/lib/mailer.ts)
# ------------------------------------------------------------
# Gunakan Gmail App Password (16 karakter), bukan password biasa:
# https://myaccount.google.com/apppasswords
EMAIL_SERVER_USER="alamat.email.anda@gmail.com"
EMAIL_SERVER_PASSWORD="app-password-16-karakter"

# Jika HOST dan PORT diisi -> SMTP eksplisit.
# Jika salah satunya kosong -> otomatis fallback ke service: 'gmail'.
# Port 587 = STARTTLS, port 465 = SSL.
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587

# Alamat pengirim. Boleh email saja atau format lengkap "Nama <email>".
# Kosongkan untuk otomatis memakai EMAIL_SERVER_USER.
EMAIL_FROM=""

# ------------------------------------------------------------
# 4. OPSIONAL
# ------------------------------------------------------------
# Konfigurasi WhatsApp Gateway TIDAK lagi memakai environment variable.
# Atur API URL, token, sender number, dan status melalui:
#   Dashboard → Pengaturan Akun → WhatsApp Gateway (khusus ADMIN).
ALLOW_DB_RESET="false"
